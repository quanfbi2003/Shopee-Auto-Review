{
  "manifest_version": 3,
  "name": "Shopee Auto Review",
  "version": "0.2.0",
  "description": "Tự đánh giá Shopee bằng thao tác trực tiếp trên giao diện trong Edge.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Auto Review",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/user/purchase*"
      ],
      "js": [
        "rules.js",
        "media.js",
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://down-vn.img.susercontent.com/*"
  ]
}
